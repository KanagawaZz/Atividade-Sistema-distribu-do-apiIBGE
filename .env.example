# Credenciais (apenas para ambiente de desenvolvimento local)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MYSQL_ROOT_PASSWORD=rootpassword
# Porta exposta do MySQL Master no host (padrao 3310 para evitar conflito com MySQL local 3306)
MYSQL_MASTER_HOST_PORT=3310

# Fonte SIDRA (LSPA = tabela 6588)
SIDRA_TABELA=6588
SIDRA_PERIODOS=last 12
SIDRA_VARIAVEIS=35,36,109,216

# Produtos monitorados (codigos c48 do SIDRA)
# 39443 Soja | 39441 Milho 1a | 39442 Milho 2a | 39456 Cana | 39432 Arroz
# 39454 Cafe arabica | 39436 Feijao 1a | 39445 Trigo | 39467 Mandioca | 39429 Algodao
SIDRA_PRODUTOS=39443,39441,39442,39456,39432,39454,39436,39445,39467,39429

# Threads de paralelismo interno por worker
WORKER_THREADS=4
